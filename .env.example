# Postgres connection string from Neon.
# Use the production branch's connection string for Production,
# and the qa branch's connection string for local dev against qa data
# (prefer `npm run dev:pr` instead when testing a PR's own schema changes —
# see scripts/dev-pr.mjs).
DATABASE_URL=

# Fallback DB for a Vercel Preview Deployment that isn't tied to an open PR
# yet (see src/instrumentation.ts) — same value as the qa DATABASE_URL
# above. Only relevant on Vercel; unused locally and in CI.
QA_DATABASE_URL=

# Password for the single-user login gate.
APP_PASSWORD=

# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
