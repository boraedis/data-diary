# Postgres connection string from Neon.
# Use the production branch's connection string for Production,
# and the qa branch's connection string for local dev against qa data
# (prefer `npm run dev:pr` instead when testing a PR's own schema changes —
# see scripts/dev-pr.mjs).
DATABASE_URL=

# Fallback DB for a Vercel Preview Deployment that isn't tied to an open PR
# yet (see src/instrumentation.ts) — same value as the qa DATABASE_URL
# above. Only relevant on Vercel; unused locally and in CI.
QA_DATABASE_URL=

# Comma-separated hostname(s) of your PRODUCTION Neon database (the host
# part only, e.g. ep-xxxx-pooler.us-east-2.aws.neon.tech — not a secret,
# just used locally to recognize when DATABASE_URL points at prod). Set
# this once and scripts/lib/prod-guard.mjs will make backfill-place-
# paths.mjs / split-duplicate-places.mjs / migrate-history.mjs stop and
# require typed confirmation (+ APP_PASSWORD below, if set) before writing,
# instead of writing silently the way it did before this existed.
PROD_DB_HOSTS=

# Password for the single-user login gate. Also doubles as the confirmation
# password prod-guard.mjs asks for before a script writes to production.
APP_PASSWORD=

# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
